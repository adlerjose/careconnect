# ==============================================================================
# CareConnect PI - Configurações de Ambiente (Template)
# ==============================================================================
# Copie este arquivo para .env e preencha com as configurações do seu ambiente local:
#   cp .env.example .env
# NUNCA commite o arquivo .env preenchido com dados sensíveis no repositório.
# ==============================================================================

# --- Aplicação FastAPI ---
PROJECT_NAME="CareConnect PI"
VERSION="0.1.0"
DESCRIPTION="Plataforma de acompanhamento pós-atendimento e triagem auxiliar via WhatsApp"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# --- CORS (Cross-Origin Resource Sharing) ---
# Lista de origens permitidas separadas por vírgula (ex: frontend React local)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Banco de Dados PostgreSQL ---
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="careconnect"
POSTGRES_USER="careconnect"
POSTGRES_PASSWORD="careconnect_dev_pwd"
DATABASE_URL="postgresql+asyncpg://careconnect:careconnect_dev_pwd@localhost:5432/careconnect"

# --- Google Gemini API (Módulo de IA) ---
# Obtenha sua chave em: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_TIMEOUT=30.0

# --- Evolution API / WhatsApp Webhook ---
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_PORT=8080
EVOLUTION_API_KEY="troque_esta_chave_em_producao"
EVOLUTION_INSTANCE_NAME="careconnect-dev"
EVOLUTION_WEBHOOK_SECRET="troque_este_secret"
