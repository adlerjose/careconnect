# ==============================================================================
# CareConnect PI - Configurações de Ambiente (Template)
# ==============================================================================
# Copie este arquivo para .env e preencha com as configurações do seu ambiente local:
#   cp .env.example .env
# NUNCA commite o arquivo .env preenchido com dados sensíveis no repositório.
# ==============================================================================

# --- Aplicação FastAPI ---
PROJECT_NAME="CareConnect PI"
VERSION="0.1.0"
DESCRIPTION="Plataforma de acompanhamento pós-atendimento e triagem auxiliar via WhatsApp"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# --- CORS (Cross-Origin Resource Sharing) ---
# Lista de origens permitidas separadas por vírgula (ex: frontend React local)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Banco de Dados PostgreSQL (Integração Futura) ---
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="careconnect_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changeme_in_production"

# --- Google Gemini API (Módulo de IA) ---
# Obtenha sua chave em: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_TIMEOUT=30.0

# --- Evolution API / WhatsApp Webhook (Integração Futura) ---
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_WEBHOOK_SECRET=""
